<?xml version="1.0"?>
<launch>
  <!-- Tunable arguments -->
  <arg name="on_time"     default="30"/>
  <arg name="period_time" default="60"/>
  <arg name="imu_topic"   default="/vectornav/imu/data"/>
  <arg name="imu_frame"   default="IMU"/>
  <arg name="use_rviz"    default="false"/>
  <arg name="record_bag"  default="true"/>
  <arg name="bag_path"    default="/home/vxs/vxs_ws/catkin_ws/src/vxs_sensor_ros1/record/vxs_li_init_record.bag"/>

  <!-- Initial CAD guess for sensor -> IMU static transform -->
  <arg name="imu_tx" default="0.0"/>
  <arg name="imu_ty" default="0.0"/>
  <arg name="imu_tz" default="0.0"/>
  <arg name="imu_roll"  default="0.0"/>
  <arg name="imu_pitch" default="0.0"/>
  <arg name="imu_yaw"   default="0.0"/>

  <!-- Frame-based pointcloud mode for LI-Init data collection -->
  <node pkg="vxs_sensor_ros1" type="vxs_node" name="vxs_node" output="screen">
    <param name="config_json" value="$(find vxs_sensor_ros1)/config/and2_median_golden.json"/>
    <param name="calib_json"  value="$(find vxs_sensor_ros1)/config/calib_27_10_8mm.json"/>
    <param name="fps" type="int" value="33"/>
    <param name="publish_depth_image" type="bool" value="false"/>
    <param name="publish_pointcloud"  type="bool" value="true"/>
    <param name="publish_events"      type="bool" value="false"/>

    <param name="binning_amount"         type="int"    value="0"/>
    <param name="prefiltering_threshold" type="double" value="2.0"/>
    <param name="filterP1"               type="double" value="0.1"/>
    <param name="temporal_threshold"     type="int"    value="4"/>
    <param name="spatial_threshold"      type="int"    value="10"/>

    <remap from="~pcloud/cloud" to="/vxs/pcloud/cloud"/>
    <remap from="~sensor/camera_info" to="/vxs/sensor/camera_info"/>
  </node>

  <node pkg="vxs_sensor_ros1" type="set_observation_window.py" name="set_observation_window"
        output="screen">
    <param name="on_time"     value="$(arg on_time)"/>
    <param name="period_time" value="$(arg period_time)"/>
  </node>

  <node pkg="tf2_ros" type="static_transform_publisher" name="camera_link_to_sensor"
        args="0 0 0 0.5 -0.5 0.5 -0.5 camera_link sensor"/>
  <node pkg="tf2_ros" type="static_transform_publisher" name="sensor_to_imu"
        args="$(arg imu_tx) $(arg imu_ty) $(arg imu_tz) $(arg imu_roll) $(arg imu_pitch) $(arg imu_yaw) sensor $(arg imu_frame)"/>

  <node if="$(arg use_rviz)" name="rviz" pkg="rviz" type="rviz" output="screen"
        args="-d $(find vxs_sensor_ros1)/config/rviz/vxs_rviz2.rviz"/>

  <node if="$(arg record_bag)" name="rosbag_record" pkg="rosbag" type="record" output="screen"
        args=" -O $(arg bag_path)
               --split --size=1024 --lz4
               /tf /tf_static
               /vxs/pcloud/cloud
               $(arg imu_topic)
               /vxs/sensor/camera_info
             "/>
</launch>
