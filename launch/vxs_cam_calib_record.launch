<?xml version="1.0"?>
<launch>
  <!-- Record VXS point cloud + OV9281 camera for VXS-camera extrinsic calibration.
       Place AprilGrid at 6-10 static poses, ~0.5-1.5m from sensor.
       For each pose: hold still for 3-5 seconds.

       Usage:
         roslaunch vxs_sensor_ros1 vxs_cam_calib_record.launch
  -->

  <arg name="bag_path" default="/home/vxs/vxs_ws/catkin_ws/src/vxs_sensor_ros1/record/vxs_cam_calib.bag"/>
  <arg name="duration" default="120"/>
  <arg name="device"   default="/dev/video1"/>

  <!-- VXS sensor — low FPS + full duty cycle for maximum point density per frame -->
  <include file="$(find vxs_sensor_ros1)/launch/vxs_events.launch">
    <arg name="rviz"        value="false"/>
    <arg name="record"      value="false"/>
    <arg name="publish_imu" value="false"/>
    <arg name="fps"         value="5"/>
    <arg name="on_time"     value="60"/>
    <arg name="period_time" value="60"/>
  </include>

  <!-- OV9281 camera -->
  <include file="$(find vxs_sensor_ros1)/launch/ov9281.launch">
    <arg name="device" value="$(arg device)"/>
  </include>

  <!-- Record both -->
  <node name="rosbag_record" pkg="rosbag" type="record" output="screen"
        args="-O $(arg bag_path)
              --duration=$(arg duration)
              /vxs/pcloud/events
              /camera/image_raw
              /camera/camera_info"/>

</launch>
