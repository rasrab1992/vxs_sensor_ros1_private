<?xml version="1.0"?>
<launch>
  <!--
    Arducam OV9281 — 1MP Global Shutter USB Camera
    Device: /dev/video1  (video0 is Jetson CSI/tegra-capture-vi)
    Native: 1280x800 @ 100fps MJPG  |  1280x720 @ 120fps MJPG
    For Kalibr: use 20fps (gives sharp images during fast motion)
  -->

  <arg name="device"     default="/dev/video1"/>
  <arg name="width"      default="1280"/>
  <arg name="height"     default="800"/>
  <arg name="framerate"  default="20"/>
  <arg name="frame_id"   default="camera"/>
  <arg name="camera_info_url" default="file:///home/vxs/vxs_ws/catkin_ws/src/vxs_sensor_ros1/calibration/ov9281_camera_info.yaml"/>

  <node pkg="usb_cam" type="usb_cam_node" name="ov9281" output="screen" respawn="true" respawn_delay="2">
    <param name="video_device"    value="$(arg device)"/>
    <param name="image_width"     value="$(arg width)"/>
    <param name="image_height"    value="$(arg height)"/>
    <param name="pixel_format"    value="mjpeg"/>
    <param name="camera_frame_id" value="$(arg frame_id)"/>
    <param name="io_method"       value="mmap"/>
    <param name="framerate"       value="$(arg framerate)"/>
    <param name="camera_name"     value="ov9281"/>
    <param name="camera_info_url" value="$(arg camera_info_url)"/>
    <remap from="ov9281/image_raw"    to="/camera/image_raw"/>
    <remap from="ov9281/camera_info"  to="/camera/camera_info"/>
  </node>

  <!-- Compress for WiFi transport to RViz on WSL -->
  <node pkg="image_transport" type="republish" name="image_compress"
        args="raw in:=/camera/image_raw compressed out:=/camera/image_raw"/>

</launch>
