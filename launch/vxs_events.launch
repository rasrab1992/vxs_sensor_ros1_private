<?xml version="1.0"?>
<launch>

  <!-- ================================================================
       Args — override from command line, e.g.:
         roslaunch vxs_sensor_ros1 vxs_events.launch publish_imu:=true
         roslaunch vxs_sensor_ros1 vxs_events.launch config_json:=$(rospack find vxs_sensor_ros1)/config/and2_noMedian_golden_imu_1.json publish_imu:=true
       ================================================================ -->
  <arg name="config_json"   default="$(find vxs_sensor_ros1)/config/and2_noMedian_golden_imu_1.json"/>
  <arg name="calib_json"    default="$(find vxs_sensor_ros1)/config/calib_07_04_8mm.json"/>
  <arg name="fps"           default="33"/>
  <arg name="publish_imu"   default="false"/>
  <arg name="record"        default="false"/>
  <arg name="rviz"          default="true"/>
  <arg name="on_time"       default="0"/>
  <arg name="period_time"   default="0"/>

  <!-- ================================================================
       Sensor node
       ================================================================ -->
  <node pkg="vxs_sensor_ros1" type="vxs_node" name="vxs_node" output="screen">
    <param name="config_json"        value="$(arg config_json)"/>
    <param name="calib_json"         value="$(arg calib_json)"/>
    <param name="fps"                type="int"  value="$(arg fps)"/>
    <param name="publish_depth_image" type="bool" value="false"/>
    <param name="publish_pointcloud"  type="bool" value="false"/>
    <param name="publish_events"      type="bool" value="true"/>
    <param name="publish_imu"         type="bool" value="$(arg publish_imu)"/>
    <!-- on_time=0/period_time=0 → continuous streaming (skips vxSetObservationWindow).
         For windowed mode pass: on_time:=30 period_time:=60  (GOLDEN mode, 0x3C) -->
    <param name="on_time"             type="int"  value="$(arg on_time)"/>
    <param name="period_time"         type="int"  value="$(arg period_time)"/>

    <param name="binning_amount"          type="int"    value="0"/>
    <param name="prefiltering_threshold"  type="double" value="2.0"/>
    <param name="filterP1"                type="double" value="0.1"/>
    <param name="temporal_threshold"      type="int"    value="4"/>
    <param name="spatial_threshold"       type="int"    value="10"/>

    <!-- stable global topics -->
    <remap from="~pcloud/events"      to="/vxs/pcloud/events"/>
    <remap from="~sensor/camera_info" to="/vxs/sensor/camera_info"/>
    <remap from="~imu"                to="/imu"/>
  </node>

  <node pkg="tf2_ros" type="static_transform_publisher" name="camera_link_to_sensor"
        args="0 0 0 0.5 -0.5 0.5 -0.5 camera_link sensor"/>

  <!-- ================================================================
       Optional RViz
       ================================================================ -->
  <node if="$(arg rviz)" name="rviz" pkg="rviz" type="rviz" output="screen"
        args="-d $(find vxs_sensor_ros1)/config/vxs_rviz2.rviz"/>

  <!-- ================================================================
       Optional rosbag recording (includes /imu when publish_imu:=true)
       ================================================================ -->
  <node if="$(arg record)" name="rosbag_record" pkg="rosbag" type="record" output="screen"
        args="-O /home/vxs/vxs_ws/catkin_ws/src/vxs_sensor_ros1/record/vxs_record.bag
              /vxs/pcloud/events
              /vxs/sensor/camera_info
              /imu"/>

</launch>